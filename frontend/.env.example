# ─── Women Safety frontend configuration ──────────────────────────────────────
# Copy to `.env.local` and adjust as needed. All variables must be prefixed with
# VITE_ to be exposed to the client bundle by Vite.

# Base URL of the Women Safety .NET API.
# Leave empty ("") when the SPA is served by the backend (same origin) — this is the
# production default and matches how the backend hosts its static files.
VITE_API_BASE_URL=

# Dev-server proxy target for `/api/*` requests (used only by `npm run dev`).
# The .NET backend listens here by default (HTTPS dev certificate is self-signed).
VITE_API_PROXY_TARGET=https://localhost:5001

# Optional: app display name shown in the navbar when no translation key applies.
VITE_APP_NAME=Women Safety BD
